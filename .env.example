# KasiBiz configuration.
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env          (Windows: copy .env.example .env)
#
# .env is git-ignored. This file is not, so NEVER put a real key in here.

# ---------------------------------------------------------------- THE SECRET
# The only real secret in this project. Get one from:
#     https://platform.openai.com/api-keys
# KasiBiz still runs without it - every calculation, the router, the six
# languages and the whole test suite work offline. The key is only used to
# reword answers more naturally.
OPENAI_API_KEY=sk-replace-me

# ------------------------------------------------------------ NOT SECRETS
# Everything below is a setting, not a credential. None of these need an
# account, a password or a key.

# Which OpenAI model to use for wording.
MODEL_NAME=gpt-4o-mini

# Where the SQLite file lives. Three slashes = relative to the project root,
# four = an absolute path. The file is created automatically.
DATABASE_URL=sqlite:///kasibiz.db

# Folder for the local ChromaDB knowledge base. Created automatically.
# ChromaDB runs embedded here - there is no server and no API key.
CHROMA_DB_PATH=chroma_db

# The shop name KasiBiz signs adverts with.
SHOP_NAME=KasiBiz Spaza

# How much detail to write to the log. INFO is right for normal use.
# Use DEBUG when you are trying to work out why something misbehaved.
KASIBIZ_LOG_LEVEL=INFO

# Leave blank to log to the console only. Set a path, for example
# KASIBIZ_LOG_FILE=logs/kasibiz.log, to keep a file as well.
KASIBIZ_LOG_FILE=
